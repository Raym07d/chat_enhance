{
  "manifest_version": 3,
  "name": "Chat Enhance",
  "version": "0.5.2",
  "description": "Copy ChatGPT responses as Markdown or Word content and save complete conversations as offline HTML.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chat Enhance",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://t0.gstatic.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "vendor/katex/katex.min.js",
        "math.js",
        "markdown.js",
        "word.js",
        "export.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
